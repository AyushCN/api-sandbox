# ------------------------------------------------------------------------------
# Core Environment Settings
# ------------------------------------------------------------------------------
# The domain where this API Sandbox will be hosted (e.g. sandbox.yourcompany.com)
# Defaults to localhost for local development
DOMAIN=localhost

# The base URL of the frontend application
# Used for CORS and email links
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Auto-Expiry / Cleanup
# ------------------------------------------------------------------------------
# Automatically stops RUNNING environments after N hours of inactivity
# Default is 6 if unset.
IDLE_TIMEOUT_HOURS=6

# ------------------------------------------------------------------------------
# Security Secrets
# ------------------------------------------------------------------------------
# Required: Secret used to sign JWT tokens. Must be a long, random string.
# Generate one using: openssl rand -base64 32
JWT_SECRET=replace_me_with_a_secure_random_string

# ------------------------------------------------------------------------------
# Database Configuration (Postgres)
# ------------------------------------------------------------------------------
# Defaults match the docker-compose.yml postgres service
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=api_sandbox
# DATABASE_URL is constructed in docker-compose.yml using the vars above.
# Only set DATABASE_URL if you are connecting to an external database.
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/api_sandbox?sslmode=disable

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# Default matches the docker-compose.yml redis service
# REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Email Configuration (SMTP / SendGrid)
# ------------------------------------------------------------------------------
# Required in production for user registration verification
# Set SKIP_EMAIL_VERIFICATION=true for local dev to bypass this requirement
SKIP_EMAIL_VERIFICATION=false

# Option A: SendGrid (Preferred if available)
# SENDGRID_API_KEY=your_sendgrid_api_key

# Option B: SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@api-sandbox.com

# ------------------------------------------------------------------------------
# Traefik / Network Settings
# ------------------------------------------------------------------------------
# Enable Let's Encrypt TLS via Traefik ACME (true/false)
# If true, you MUST provide a valid DOMAIN and ACME_EMAIL, and the server must
# be publicly accessible on ports 80 and 443.
ENABLE_TLS=false
ACME_EMAIL=admin@example.com

# Enable the Traefik dashboard (Warning: Insecure, accessible on port 8081)
TRAEFIK_DASHBOARD=false

# Traefik Entrypoint override (default is web, change to websecure if TLS is enabled)
# TRAEFIK_ENTRYPOINT=web
