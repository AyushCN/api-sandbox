# ------------------------------------------------------------------------------
# Core Environment Settings
# ------------------------------------------------------------------------------
# The domain where this API Sandbox will be hosted (e.g. sandbox.yourcompany.com)
# Defaults to localhost for local development
DOMAIN=localhost

# The base URL of the frontend application
# Used for CORS and email links
APP_URL=http://localhost

# ------------------------------------------------------------------------------
# Host Paths (REQUIRED for Docker deployment)
# ------------------------------------------------------------------------------
# The absolute path on the host machine where workspaces will be stored.
# This must be an absolute path because the backend passes it directly to the host's Docker daemon.
HOST_WORKSPACES_DIR=/var/lib/api-sandbox/workspaces

# ------------------------------------------------------------------------------
# Auto-Expiry / Cleanup
# ------------------------------------------------------------------------------
# Automatically stops RUNNING environments after N hours of inactivity
# Default is 6 if unset.
IDLE_TIMEOUT_HOURS=6

# ------------------------------------------------------------------------------
# Security & Auth Secrets
# ------------------------------------------------------------------------------
# Required: Secret used to sign JWT tokens. Must be a long, random string.
# Generate one using: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_secure_random_string

# Required for GitHub OAuth integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Required: AES-256 key for encrypting GitHub tokens in the database
# Generate one using: openssl rand -hex 16 (Must be exactly 32 characters)
TOKEN_ENCRYPTION_KEY=replace_me_with_a_32_character_hex_string_

# ------------------------------------------------------------------------------
# Database Configuration (Postgres)
# ------------------------------------------------------------------------------
# Defaults match the docker-compose.yml postgres service
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=api_sandbox
# DATABASE_URL is constructed from the vars above if empty.
# When running the backend locally (not in docker), uncomment this:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_sandbox?sslmode=disable

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# When running the backend locally (not in docker), uncomment this:
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Email Configuration (SMTP / SendGrid)
# ------------------------------------------------------------------------------
# Required in production for user registration verification
# Set SKIP_EMAIL_VERIFICATION=true for local dev to bypass this requirement
SKIP_EMAIL_VERIFICATION=false

# Option A: SendGrid (Preferred if available)
# SENDGRID_API_KEY=your_sendgrid_api_key

# Option B: SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@api-sandbox.com

# ------------------------------------------------------------------------------
# Traefik / Network Settings
# ------------------------------------------------------------------------------
# Enable Let's Encrypt TLS via Traefik ACME (true/false)
# If true, you MUST provide a valid DOMAIN and ACME_EMAIL, and the server must
# be publicly accessible on ports 80 and 443.
ENABLE_TLS=false
ACME_EMAIL=admin@example.com

# Enable the Traefik dashboard (Warning: Insecure, accessible on port 8081)
TRAEFIK_DASHBOARD=false

# Traefik Entrypoint override (default is web, change to websecure if TLS is enabled)
# TRAEFIK_ENTRYPOINT=web
