package main

import (
	"fmt"
	"github.com/fsouza/go-dockerclient"
)

func main() {
	opts := docker.CreateContainerOptions{
		NetworkingConfig: &docker.NetworkingConfig{
			EndpointsConfig: map[string]*docker.EndpointConfig{
				"test": &docker.EndpointConfig{},
			},
		},
	}
	fmt.Printf("%T\n", opts)
}
